# ============================================================
# LitShowShare - Docker deployment env template
# Copy to .env (in the same directory as docker-compose.yml) and edit.
# ============================================================

# -------- Image registry (Aliyun ACR recommended) --------
# Use the region closest to your VPS for best pull speed.
#   Hangzhou: registry.cn-hangzhou.aliyuncs.com
#   Beijing : registry.cn-beijing.aliyuncs.com
#   Shanghai: registry.cn-shanghai.aliyuncs.com
#   Shenzhen: registry.cn-shenzhen.aliyuncs.com
IMAGE_REGISTRY=registry.cn-hangzhou.aliyuncs.com
IMAGE_NAMESPACE=your-namespace
IMAGE_NAME=litshowshare
IMAGE_TAG=latest

# -------- Host port mapping --------
# Container always listens on 3001. Change host port if needed.
HOST_PORT=3001

# -------- Host user mapping (bind-mount permission fix) --------
# Container will chown ./data and ./uploads to this uid:gid on start,
# then run the app as that user. Default 1000:1000 matches most Linux
# users. Find yours with: id -u  /  id -g
PUID=1000
PGID=1000

# -------- Backend secrets --------
# REQUIRED: set a strong random secret for JWT signing.
JWT_SECRET=please-change-me-to-a-long-random-string

# -------- Push credentials (only needed by build/push scripts) --------
# DO NOT commit real values. Recommended: export as shell env vars instead.
ACR_USERNAME= 
ACR_PASSWORD=
